# Firebase piloto (Oleada 7) — copia a .env.local y rellena desde Firebase Console
# Project settings → Your apps → SDK setup (Web) → aurora-postura-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aurora-postura-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aurora-postura-app
VITE_FIREBASE_STORAGE_BUCKET=aurora-postura-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# false = Firebase en la nube (producción piloto) — recomendado
VITE_FIREBASE_USE_EMULATORS=false

# Validar antes de dev: npm run firebase:prep

# Agente de fuentes — Tavily (solo servidor dev/proxy; no expongas en VITE_)
TAVILY_API_KEY=

# YouTube Data API v3 — resolver @handle, buscar canales y videos educativos
YOUTUBE_API_KEY=

# Producción: base de Cloud Functions para RSS/Tavily (sin barra final)
# VITE_POSTURA_FUNCTIONS_BASE=https://us-central1-aurora-postura-app.cloudfunctions.net
