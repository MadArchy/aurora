rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'ADMIN';
    }

    function ownsClient(clientId) {
      return signedIn() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.clientId == clientId
      );
    }

    match /organizations/{orgId} {
      allow read: if signedIn() && request.auth.token.organizationId == orgId;
      allow write: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if ownsClient(clientId);
      allow write: if isAdmin();
    }

    match /clients/{clientId}/{collection=**}/{docId} {
      allow read, write: if ownsClient(clientId);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
