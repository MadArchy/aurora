{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src/**/*.ts",
    "../src/domain/ai/**/*.ts",
    "../src/domain/scoringCore.ts",
    "../src/domain/dispositionCore.ts",
    "../src/domain/textMatchCore.ts",
    "../src/domain/thesisModelCore.ts",
    "../src/types/index.ts",
    "../src/application/ai/**/*.ts",
    "../src/infrastructure/ai/**/*.ts",
    "../src/interfaces/ai/**/*.ts",
    "../src/composition/ai/serverGatewayComposition.ts"
  ],
  "exclude": ["../src/composition/ai/testGatewayComposition.ts"]
}
